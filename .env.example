# ==============================================================================
# Joy University Smart Campus ERP - Frontend Environment Configuration Template
# Duplicate this file to .env and adjust variables as required.
# ==============================================================================

# API Base Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Authentication & Session Endpoints
VITE_AUTH_LOGIN_ENDPOINT=/auth/login
VITE_AUTH_ME_ENDPOINT=/auth/me
VITE_AUTH_LOGOUT_ENDPOINT=/auth/logout

# Student Portal Endpoints
VITE_STUDENT_PROFILE_ENDPOINT=/student/me
VITE_STUDENT_DASHBOARD_ENDPOINT=/student/me/dashboard
VITE_STUDENT_TIMETABLE_ENDPOINT=/student/me/timetable
VITE_STUDENT_COURSES_ENDPOINT=/student/me/courses
VITE_STUDENT_ATTENDANCE_ENDPOINT=/student/me/attendance
VITE_STUDENT_ATTENDANCE_SUMMARY_ENDPOINT=/student/me/attendance/summary

# Faculty Portal Endpoints
VITE_FACULTY_PROFILE_ENDPOINT=/faculty/me
VITE_FACULTY_DASHBOARD_ENDPOINT=/faculty/dashboard
VITE_FACULTY_TIMETABLE_ENDPOINT=/faculty/timetable
VITE_FACULTY_COURSES_ENDPOINT=/faculty/courses
VITE_FACULTY_SECTIONS_ENDPOINT=/faculty/sections
VITE_FACULTY_SESSIONS_ENDPOINT=/faculty/attendance/sessions
VITE_FACULTY_SUMMARY_ENDPOINT=/faculty/attendance/summary

# Admin Management Endpoints
VITE_ADMIN_DASHBOARD_STATS_ENDPOINT=/admin/dashboard-stats
VITE_ADMIN_STUDENTS_ENDPOINT=/students
VITE_ADMIN_FACULTY_ENDPOINT=/staff/t
VITE_ADMIN_DEPARTMENTS_ENDPOINT=/departments
VITE_ADMIN_BLOCKS_ENDPOINT=/blocks
VITE_ADMIN_CLASSROOMS_ENDPOINT=/classrooms
VITE_ADMIN_SUBJECTS_ENDPOINT=/subjects
VITE_ADMIN_COURSE_OFFERINGS_ENDPOINT=/course-offerings
VITE_ADMIN_SECTIONS_ENDPOINT=/sections
VITE_ADMIN_TIMETABLE_ENDPOINT=/timetable
VITE_ADMIN_ATTENDANCE_SESSIONS_ENDPOINT=/attendance/sessions

# Anonymous / Demo Test Credentials (Pre-seeded for testing and anonymous sign-in)
# Administrator
VITE_DEMO_ADMIN_USERNAME=admin
VITE_DEMO_ADMIN_PASSWORD=Admin@123

# Faculty / Teaching Staff
VITE_DEMO_FACULTY_USERNAME=FAC001
VITE_DEMO_FACULTY_PASSWORD=Faculty@123

# Student
VITE_DEMO_STUDENT_USERNAME=J26AIM001
VITE_DEMO_STUDENT_PASSWORD=Student@123
